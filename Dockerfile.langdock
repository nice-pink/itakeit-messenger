FROM cgr.dev/chainguard/go:latest-dev AS builder

LABEL org.opencontainers.image.source="https://github.com/nice-pink/itakeit-messager"

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 ./build

# For backend: langdock only. It calls Langdock's HTTP API, so the image has no
# Claude Code CLI and no Node. A config with backend claude-code fails its start
# probe here, since there is no claude binary. Static carries the CA certificates
# the Go binary needs for Slack and Langdock, and runs as a non-root user.
FROM cgr.dev/chainguard/static:latest

LABEL org.opencontainers.image.source="https://github.com/nice-pink/itakeit-messager"

COPY --from=builder /app/bin/itakeit-messager /app/itakeit-messager
ENTRYPOINT [ "/app/itakeit-messager", "-config", "/config/config.yaml" ]
